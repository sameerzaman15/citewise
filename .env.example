# Chat. Leave both keys empty to run retrieval only.
LLM_PROVIDER=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=

# Embeddings. Unset uses OpenAI when OPENAI_API_KEY is set, otherwise the browser model.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Optional shared rate limits. Without these, limits are in-memory on each instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_CHAT_PER_10MIN=20
RATE_LIMIT_INGEST_PER_10MIN=6
RATE_LIMIT_EMBED_PER_10MIN=60
DAILY_REQUEST_CAP=500

# Public site URL used for metadata. Example: https://citewise-demo.vercel.app
NEXT_PUBLIC_SITE_URL=
